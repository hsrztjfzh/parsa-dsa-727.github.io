<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>خرید و فروش اکانت کالاف | VGR STORE</title>
<meta name="description" content="خرید و فروش اکانت کالاف دیوتی موبایل. ثبت آگهی اکانت و خرید از کانال تلگرام VGR STORE.">
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;700;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#050505;--card:#0e0e10;--ink:#f2f2f2;--muted:#a8a8ad;--red:#ff1a3c;--on-red:#fff;
color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Vazirmatn,Tahoma,sans-serif;line-height:1.9}
.hero{background:#000;text-align:center;padding:28px 12px 32px;border-bottom:2px solid var(--red);border-radius:0 0 28px 28px}
.hero img{display:block;margin:0 auto;width:100%;max-width:520px;height:auto}
.hero h1{font-size:1.7rem;font-weight:900;margin:8px 0 4px}
.hero p{margin:0 auto;max-width:34ch;color:var(--muted)}
main{max-width:560px;margin:0 auto;padding:28px 20px 48px}
.row{display:grid;gap:14px}
.btn{font:inherit;font-weight:700;font-size:1.05rem;text-decoration:none;text-align:center;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;padding:16px 20px;border-radius:16px;border:2px solid var(--red);background:var(--red);color:var(--on-red)}
a.btn.alt{background:var(--card);color:var(--ink)}
.btn:focus-visible,input:focus-visible{outline:3px solid #fff;outline-offset:3px}
.note{color:var(--muted);font-size:.9rem;text-align:center;margin-top:20px}
dialog{width:min(520px,92vw);max-height:90vh;overflow:auto;border:2px solid var(--red);border-radius:24px;padding:24px;background:var(--card);color:var(--ink)}
dialog::backdrop{background:rgba(0,0,0,.75)}
dialog h2{margin:0 0 12px;font-size:1.3rem}
label{display:block;font-weight:700;font-size:.92rem;margin:10px 0 2px}
input[type=text],input:not([type]){width:100%;font:inherit;padding:10px 12px;border-radius:12px;border:1.5px solid var(--red);background:var(--bg);color:var(--ink)}
.pick{margin-top:12px;background:var(--bg);border-style:dashed;color:var(--ink)}
.pickwrap{position:relative;margin-top:12px}
.pickwrap .pick{margin-top:0}
#file{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;font-size:0}
.thumbs{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.thumbs img{width:72px;height:72px;object-fit:cover;border-radius:10px;border:1.5px solid var(--red)}
.warn{border:1.5px solid var(--red);border-radius:12px;padding:10px 12px;margin:16px 0;font-size:.9rem;color:var(--muted)}
.err{color:#ff6b81;font-weight:700;min-height:1.6em;margin:6px 0}
.close{background:transparent;color:var(--muted);border-color:transparent;margin-top:6px;width:100%}
</style>
</head>
<body>
<header class="hero">
<img src="data:image/jpeg;base64," alt="VGR STORE" width="960" height="280">
<h1>خرید و فروش اکانت کالاف</h1>
<p>آگهی اکانتت رو ثبت کن یا از کانال، اکانت بخر.</p>
</header>
<main>
<div class="row">
<button class="btn" id="open" type="button">📋 ثبت آگهی</button>
<a class="btn alt" href="https://t.me/VGR_Store_codm" target="_blank" rel="noopener">🛒 خرید اکانت</a>
</div>
<p class="note">برای خرید اکانت، به کانال تلگرام مراجعه کنید.</p>
</main>

<dialog id="dlg">
<h2>📋 اطلاعات اکانت</h2>
<form id="f" novalidate>
<label for="uid">یو آیدی عددی (UID)</label><input id="uid" inputmode="numeric">
<label for="name">اسم اکانت</label><input id="name">
<label for="level">لول اکانت</label><input id="level" inputmode="numeric">
<label for="rank">رنک اکانت</label><input id="rank">
<label for="leg">تعداد گان لجند</label><input id="leg" inputmode="numeric">
<label for="myth">تعداد گان متیک</label><input id="myth" inputmode="numeric">
<label for="price">قیمت اکانت (تومان)</label><input id="price" inputmode="numeric">
<label for="seller">آیدی فروشنده</label><input id="seller">
<div class="pickwrap"><span class="btn pick">📸 انتخاب عکس اکانت</span>
<input id="file" type="file" accept="image/*" multiple aria-label="انتخاب عکس اکانت"></div>
<div class="thumbs" id="thumbs"></div>
<div class="warn">📸 عکس اکانت را هم همراه اطلاعات ارسال کنید.<br>⚠️ در صورت کامل نبودن اطلاعات، آگهی تایید نمی‌شود.</div>
<div class="err" id="err" role="alert"></div>
<button class="btn" type="submit" style="width:100%">ارسال در تلگرام</button>
<button class="btn close" type="button" id="close">بستن</button>
</form>
</dialog>

<script>
var ADMIN = "Parsa_xxxxx"; // یوزرنیم تلگرام ادمین بدون @
var dlg = document.getElementById("dlg"), err = document.getElementById("err"), files = [];
document.getElementById("open").onclick = function(){ dlg.showModal(); };
document.getElementById("close").onclick = function(){ dlg.close(); };
document.getElementById("file").onchange = function(e){
  files = Array.prototype.slice.call(e.target.files, 0, 5);
  var th = document.getElementById("thumbs"); th.innerHTML = "";
  files.forEach(function(f){ var i = document.createElement("img"); i.src = URL.createObjectURL(f); i.alt = ""; th.appendChild(i); });
};
document.getElementById("f").onsubmit = function(e){
  e.preventDefault();
  var ids = ["uid","name","level","rank","leg","myth","price","seller"];
  var v = ids.map(function(i){ return document.getElementById(i).value.trim(); });
  if (v.some(function(x){ return !x; })) { err.textContent = "همه‌ی فیلدها باید پر بشن."; return; }
  if (!files.length) { err.textContent = "عکس اکانت رو اضافه کن."; return; }
  err.textContent = "";
  var t = "📋 اطلاعات اکانت:\n\nیو آیدی عددی (UID): " + v[0] + "\nاسم اکانت: " + v[1] + "\nلول اکانت: " + v[2] + "\nرنک اکانت: " + v[3] + "\nتعداد گان لجند: " + v[4] + "\nتعداد گان متیک: " + v[5] + "\nقیمت اکانت (تومان): " + v[6] + "\nآیدی فروشنده: " + v[7];
  var q = encodeURIComponent(t + "\n\n📸 عکس اکانت رو هم همین‌جا بفرست.");
  var url = "https://t.me/" + ADMIN + "?text=" + q;
  var a = document.createElement("a"); a.href = url; a.target = "_blank"; a.rel = "noopener";
  document.body.appendChild(a); a.click(); a.remove();
  err.textContent = "متن آگهی توی تلگرام باز شد، عکس رو همون‌جا ضمیمه کن.";
};
</script>
</body>
</html>
